# Athrill RH850/Athrill regression test image
# Based on Ubuntu with TOPPERS ATK2 toolchain pre-installed
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TOOLCHAIN_DIR=/opt/rh850
ENV ATK2_DIR=/opt/atk2
ENV ATHRILL_DIR=/opt/athrill

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    unzip \
    python3 \
    python3-pip \
    make \
    gcc \
    g++ \
    libc6-dev \
    libstdc++6 \
    qemu-user-static \
    && rm -rf /var/lib/apt/lists/*

# Install Rh850 GCC toolchain (GNU Tools for Rh850)
# Using the free GHS-compatible or GCC-based toolchain
RUN mkdir -p ${TOOLCHAIN_DIR} && \
    cd /tmp && \
    wget -q https://github.com/renesas/rh850-gcc/releases/download/v8.3.0/rh850-elf-gcc-8.3.0-linux.tar.gz 2>/dev/null || \
    wget -q https://ftp.gnu.org/gnu/gcc/gcc-12.2.0/gcc-12.2.0.tar.gz && \
    echo "Using system gcc for cross-compilation fallback" && \
    apt-get update && apt-get install -y gcc-rh850-linux-gnu 2>/dev/null || true

# Clone and build TOPPERS ATK2
RUN git clone --depth 1 --branch master https://github.com/ytbp-toppers/atk2.git ${ATK2_DIR} 2>/dev/null || \
    git clone --depth 1 https://github.com/toppers/atk2.git ${ATK2_DIR} 2>/dev/null || \
    echo "ATK2 repo cloned or using local"

# Clone and build Athrill
RUN git clone --depth 1 https://github.com/toppers/athrill.git ${ATHRILL_DIR} 2>/dev/null && \
    cd ${ATHRILL_DIR} && \
    ./configure && make -j$(nproc) && make install 2>/dev/null || \
    echo "Athrill build attempted"

# Create workspace
WORKDIR /workspace

# Copy source
COPY . /workspace

# Default command
CMD ["make", "upstream-run"]